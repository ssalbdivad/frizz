{
  "name": "frizz-vscode",
  "displayName": "Frizz",
  "description": "Ask Frizz about the code in front of you, and open Frizz's file links in this window",
  "version": "0.1.0",
  "private": true,
  "publisher": "ssalbdivad",
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://github.com/ssalbdivad/frizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssalbdivad/frizz.git",
    "directory": "packages/vscode"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "dist/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "frizz",
    "agents",
    "claude-code",
    "codex"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "frizz.ask",
        "title": "Ask Frizz…",
        "category": "Frizz"
      },
      {
        "command": "frizz.sendToThread",
        "title": "Send to Frizz thread…",
        "category": "Frizz"
      },
      {
        "command": "frizz.addToPrompt",
        "title": "Add to Frizz prompt",
        "category": "Frizz"
      },
      {
        "command": "frizz.addFileToPrompt",
        "title": "Add file to Frizz prompt",
        "category": "Frizz"
      },
      {
        "command": "frizz.addSelectionOrFile",
        "title": "Add selection or file to Frizz prompt",
        "category": "Frizz"
      },
      {
        "command": "frizz.addTerminalSelection",
        "title": "Add to Frizz prompt",
        "category": "Frizz"
      },
      {
        "command": "frizz.addProblems",
        "title": "Add problems in this file to Frizz prompt",
        "category": "Frizz"
      },
      {
        "command": "frizz.addTerminalOutput",
        "title": "Add last terminal command to Frizz prompt",
        "category": "Frizz"
      },
      {
        "command": "frizz.askToFix",
        "title": "Ask Frizz to fix",
        "category": "Frizz"
      },
      {
        "command": "frizz.sidebar.queue",
        "title": "Back to queue",
        "category": "Frizz",
        "icon": "$(arrow-left)"
      },
      {
        "command": "frizz.sidebar.newThread",
        "title": "New thread",
        "category": "Frizz",
        "icon": "$(add)"
      },
      {
        "command": "frizz.sidebar.jump",
        "title": "Jump to a thread",
        "category": "Frizz",
        "icon": "$(search)"
      },
      {
        "command": "frizz.sidebar.settings",
        "title": "Settings",
        "category": "Frizz",
        "icon": "$(gear)"
      },
      {
        "command": "frizz.sidebar.shortcuts",
        "title": "Keyboard shortcuts",
        "category": "Frizz",
        "icon": "$(keyboard)"
      },
      {
        "command": "frizz.open",
        "title": "Open in browser",
        "category": "Frizz",
        "icon": "$(link-external)"
      },
      {
        "command": "frizz.sidebar.reload",
        "title": "Reload sidebar",
        "category": "Frizz",
        "icon": "$(refresh)"
      },
      {
        "command": "frizz.showLog",
        "title": "Show log",
        "category": "Frizz"
      },
      {
        "command": "frizz.reconnect",
        "title": "Reconnect",
        "category": "Frizz"
      }
    ],
    "submenus": [
      {
        "id": "frizz.editor",
        "label": "Frizz"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "frizz.editor",
          "group": "frizz"
        }
      ],
      "frizz.editor": [
        {
          "command": "frizz.ask",
          "group": "frizz@1"
        },
        {
          "command": "frizz.sendToThread",
          "group": "frizz@2"
        },
        {
          "command": "frizz.addToPrompt",
          "group": "frizz@3"
        },
        {
          "command": "frizz.addFileToPrompt",
          "group": "frizz@4"
        },
        {
          "command": "frizz.addProblems",
          "when": "config.frizz.useSidebar",
          "group": "frizz@5"
        }
      ],
      "explorer/context": [
        {
          "command": "frizz.ask",
          "when": "!explorerResourceIsFolder",
          "group": "frizz@1"
        },
        {
          "command": "frizz.addFileToPrompt",
          "when": "!explorerResourceIsFolder",
          "group": "frizz@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "frizz.addFileToPrompt",
          "when": "resourceScheme == file",
          "group": "frizz@1"
        }
      ],
      "terminal/context": [
        {
          "command": "frizz.addTerminalSelection",
          "when": "terminalTextSelected && config.frizz.useSidebar",
          "group": "frizz@1"
        },
        {
          "command": "frizz.addTerminalOutput",
          "when": "config.frizz.useSidebar",
          "group": "frizz@2"
        }
      ],
      "view/title": [
        {
          "command": "frizz.sidebar.queue",
          "when": "view == frizz.sidebar && frizz.sidebarView == thread",
          "group": "navigation@1"
        },
        {
          "command": "frizz.sidebar.newThread",
          "when": "view == frizz.sidebar && frizz.sidebarView && frizz.sidebarView != thread",
          "group": "navigation@2"
        },
        {
          "command": "frizz.sidebar.jump",
          "when": "view == frizz.sidebar && frizz.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "frizz.sidebar.settings",
          "when": "view == frizz.sidebar && frizz.sidebarView",
          "group": "navigation@4"
        },
        {
          "command": "frizz.sidebar.reload",
          "when": "view == frizz.sidebar",
          "group": "frizz@1"
        },
        {
          "command": "frizz.open",
          "when": "view == frizz.sidebar",
          "group": "frizz@2"
        },
        {
          "command": "frizz.sidebar.shortcuts",
          "when": "view == frizz.sidebar && frizz.sidebarView",
          "group": "frizz@3"
        }
      ],
      "commandPalette": [
        {
          "command": "frizz.askToFix",
          "when": "false"
        },
        {
          "command": "frizz.addTerminalSelection",
          "when": "false"
        },
        {
          "command": "frizz.addSelectionOrFile",
          "when": "false"
        },
        {
          "command": "frizz.addProblems",
          "when": "config.frizz.useSidebar"
        },
        {
          "command": "frizz.addTerminalOutput",
          "when": "config.frizz.useSidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "frizz.addToPrompt",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "frizz.addToPrompt",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "frizz.addSelectionOrFile",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Frizz",
      "properties": {
        "frizz.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Frizz server's address, such as `http://127.0.0.1:9393`. Leave empty to find the Frizz running on this machine."
        },
        "frizz.openFileLinks": {
          "type": "boolean",
          "default": true,
          "description": "Open file links from Frizz in this window"
        },
        "frizz.shareEditorState": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let Frizz's agents see what you have in front of you in this window when they need it: the file you are in, what you have selected and its text, your open tabs, and the editor's errors and warnings — so you can ask about \"this\" without pasting it. Turn it off to keep the editor to yourself."
        },
        "frizz.notify": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification when a thread in this window's Frizz project needs you — a question, a request to approve, a finished turn — while the Frizz sidebar is out of sight. Only the window you used last shows it."
        },
        "frizz.useSidebar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Put what you add from the editor — **Add to Frizz prompt** (`Ctrl+L`), a file, a problem's **Ask Frizz to fix**, a terminal selection — and **Ask Frizz…** and **Send to Frizz thread…** into the Frizz sidebar's prompt box, to write the rest there. Turn it off to send selections and files to Frizz in your browser, and to type Ask and Send messages in an input box."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frizz",
          "title": "Frizz",
          "icon": "media/frizz.svg"
        }
      ]
    },
    "views": {
      "frizz": [
        {
          "type": "webview",
          "id": "frizz.sidebar",
          "name": "Frizz"
        }
      ]
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "package": "nub scripts/build.ts && nubx -y -p @vscode/vsce@3.9.2 vsce package --no-dependencies --out dist/",
    "e2e": "nub scripts/e2e.ts"
  },
  "dependencies": {
    "ws": "^8.18"
  },
  "devDependencies": {
    "@frizz/server": "workspace:*",
    "@frizz/shared": "workspace:*",
    "@types/node": "^24",
    "@types/vscode": "1.90.0",
    "@types/ws": "^8.5",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7"
  }
}
