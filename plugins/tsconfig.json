{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // A plugin's two halves in one check: `server.ts` runs in the server (node types), `web.ts` in the page
    // (DOM). Each imports only TYPES from Frizz, so this is the whole of what a plugin's code is checked
    // against — and install.ts, the script that links one into a data directory.
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": ["*.ts", "*/*.ts"]
}
