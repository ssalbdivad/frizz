{
  "framework": "nextjs",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.frizz.sh"
        }
      ],
      "destination": "https://frizz.sh/$1",
      "permanent": true
    }
  ]
}
